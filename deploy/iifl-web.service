[Unit]
Description=IIFL trading dashboard (Gunicorn)
After=network-online.target
Wants=network-online.target

[Service]
User=root
WorkingDirectory=/root/iifl
Environment=PYTHONUNBUFFERED=1
# One worker process keeps a single Flask session secret and DB writer; threads serve requests.
ExecStart=/root/iifl/venv/bin/gunicorn --workers 1 --threads 4 --bind 127.0.0.1:5015 --timeout 60 --access-logfile - app:app
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
