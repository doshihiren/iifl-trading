# Existing IIFL credentials/settings
IIFL_API_KEY=
IIFL_API_SECRET=
IIFL_CLIENT_ID=
IIFL_APP_KEY=
IIFL_REDIRECT_URL=https://aweliontech.com/iifl/callback
IIFL_BASE_URL=https://api.iiflcapital.com

# Live trading safety gates.
# Keep both false until IIFL confirms the VPS trading IP.
LIVE_TRADING=false
IIFL_TRADING_IP_AUTHORIZED=false


# Dashboard login
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=
FLASK_SECRET_KEY=

# ---- LIVE automation limits (added for the automated engine) ----
# Total capital for all bots of one mode (LIVE and PAPER are counted separately)
GLOBAL_MAX_CAPITAL=100000
# Send a short tag with each LIVE order (set false if IIFL rejects orderTag)
SEND_ORDER_TAG=true
# INTRADAY: no new entries after, and automatic square-off at (IST)
INTRADAY_LAST_ENTRY=15:00
INTRADAY_SQUAREOFF=15:10
BOT_DB_FILE=/root/iifl/data/iifl.db
